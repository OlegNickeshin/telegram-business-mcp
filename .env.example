# ===========================================================================
#  telegram-archive-mcp
#
#  Copy to .env, fill in, keep it out of git (it already is).
#  Everything below lives on the server. No client, no laptop, no browser
#  extension ever sees any of it.
# ===========================================================================

# --- Telegram --------------------------------------------------------------
# Bot token from @BotFather. The bot must be linked under
# Telegram -> Settings -> Business -> Chatbots.
TELEGRAM_BOT_TOKEN=123456789:AA...replace-me...

# SQLite archive. The collector writes it; everything else reads it.
DB_PATH=./data/telegram.db

# getUpdates long-poll timeout, seconds.
POLL_TIMEOUT=30
# Dump every raw update as JSON while debugging (1/0).
LOG_RAW=0

# --- MCP server ------------------------------------------------------------
# Binds to loopback; put a TLS reverse proxy in front (see deploy/).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8124

# Required on every request. Accepted as `Authorization: Bearer <secret>`,
# as `?k=<secret>`, or as a trailing path segment. Generate with:
#   openssl rand -hex 32
MCP_HTTP_SECRET=change-me-openssl-rand-hex-32

# Public base URL of the MCP endpoint. Also used to build photo links, so
# leaving it empty means photos can only be returned as raw bytes.
MCP_PUBLIC_URL=https://your.host/tg-mcp

# Size budget for a photo handed to a model. Telegram ships several ready-made
# variants, so this picks a smaller one rather than re-encoding.
MCP_PHOTO_MAX_BYTES=200000
# Same, for a photo served over a link, where base64 overhead does not apply.
MCP_IMG_MAX_BYTES=600000
# Put raw image bytes in the tool result. Correct MCP and Claude renders it,
# but ChatGPT ignores such blocks and may return an empty answer. Opt-in.
MCP_INLINE_IMAGE=0

# ===========================================================================
#  CAPABILITIES
#
#  A fresh install is a read-only archive. The two switches that reach outside
#  this server are off, because the endpoint URL is effectively the credential
#  and a leaked read-only URL is a very different incident from one that can
#  write to your contacts. Turn them on deliberately.
# ===========================================================================

# Lets the model send Telegram messages as you, edit ones you already sent,
# and mark chats read. Messages reach real people immediately and cannot be
# recalled. Only chats already in the archive can be written to, so a wrong id
# cannot reach a stranger — but a wrong *wording* still lands.
#
# The single most consequential line in this file: with it on, whoever holds
# the endpoint URL can write to your contacts as you. Set 1 for the full
# "tell ChatGPT to reply and it replies" experience, once you have verified
# reading works and you are comfortable with what the URL is worth.
ALLOW_SEND=0

# Lets the model fetch what people sent you: a photo it can look at, and any
# attachment (PDF, spreadsheet, document, video, audio) as a download link.
# Receive only — this never uploads anything. Reads only; nothing leaves the
# server, nothing changes in Telegram. Telegram itself refuses to serve any
# file over 20 MB to a bot, so those cannot be fetched at all.
ALLOW_MEDIA=1

# Lets the model delete rows from the local archive. Telegram is untouched:
# the messages stay there for both people, this only discards our copy — but
# that copy is the only searchable history you have, and there is no undo.
# Logical delete: freed pages may still hold the bytes until reused.
ALLOW_FORGET=0

# Not implemented on purpose: deleting messages in Telegram itself. The Bot API
# offers deleteBusinessMessages and it works, but it is the one irreversible
# operation here — a single wrong message_id destroys someone else's message
# for both sides. Adding it should cost a code change, not a flag flip.

# ===========================================================================
#  OPTIONAL MODULES — each inert until configured
# ===========================================================================

# --- Local transcription (whisper.cpp) -------------------------------------
# Absent binary or model = the transcriber exits and nothing else notices.
WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin
# Pin the language; "auto" mis-detects short clips.
WHISPER_LANG=ru
WHISPER_THREADS=2
# Voice notes and round video messages: both are capped at a minute by Telegram,
# so they are cheap. Full video files are not included by default — those run
# for minutes each on two cores. Widening this list re-queues anything parked
# by an earlier, narrower one.
TRANSCRIBE_TYPES=voice,video_note
TRANSCRIBE_POLL_SECONDS=30

# --- Linear mirror ---------------------------------------------------------
# One issue per chat, one comment per message, so a phone client that cannot
# use custom MCP connectors can still read the archive. Empty key = inert.
# Personal API key: Linear -> Settings -> Account -> Security & Access.
LINEAR_API_KEY=
# Team to file the issues under, by key (e.g. TEL). Empty = first team.
LINEAR_TEAM_KEY=
# IANA zone for timestamps written into comments.
LINEAR_TIMEZONE=UTC
LINEAR_POLL_SECONDS=20
LINEAR_BATCH=50
LINEAR_TITLE_PREFIX=TG ·

# A comment starting with one of these, inside an issue this sync created, is
# delivered to that contact as a Telegram message. Requires ALLOW_SEND=1.
# Do not use a bare ">": Linear's editor turns it into a blockquote and the
# marker never reaches the API.
LINEAR_SEND_PREFIX=tg:,[SEND],>>

# Upload photos to Linear so they can be viewed from a phone.
LINEAR_MIRROR_PHOTOS=1
LINEAR_PHOTO_MAX_BYTES=400000
